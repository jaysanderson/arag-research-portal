# Progress Agentic RAG - account level (used by `deno task provision` only)
ARAG_ZONE=aws-ap-southeast-2-1
ARAG_ACCOUNT=your-account-id
ARAG_NUA_KEY=your-account-nua-key

# Per-tenant knowledge box bindings (written automatically by `deno task provision`)
# ARAG_KB_GRDC=...
# ARAG_KB_GRDC_TOKEN=...
# ARAG_KB_FRDC=...
# ARAG_KB_FRDC_TOKEN=...

# Admin passcode. Required to use the admin surface (provisioning, corpus
# upload, labels, graph config, agents, branding). Without this set, every
# /api/admin/* route returns 503 { error: "admin_disabled" } rather than
# silently accepting requests - there is no default passcode.
# ADMIN_PASSCODE=choose-a-long-random-value

# Port the API server listens on. Defaults to 8787 if unset.
# PORT=8787

# Directory for the small app-side JSON/JSONL stores (insights, sessions,
# watches, sources, investigations, suggestions). Defaults to ./data.
# In production (Dockerfile/fly.toml) this is set to /app/data, a mounted
# Fly volume.
# DATA_DIR=./data

# Individual store file paths. Each defaults to a file under DATA_DIR /
# ./data and only needs setting if you want a store somewhere else (this is
# how fly.toml points them at the mounted volume in production).
# BINDINGS_PATH=./data/bindings.json
# TENANTS_PATH=./data/tenants.json
# KG_PROPOSALS_PATH=./data/kg-proposals.json
# BRANDING_PATH=./data/branding

# Anonymous per-IP rate limits for the paid-LLM routes (ask, generate, summarize,
# subqueries, verdicts, synthesise) and for POST /api/ask-estate, which fans one
# request across every tenant. Requests per minute per client IP; set to 0 to
# disable that tier entirely. Admin routes (passcode-gated) are never rate limited.
# RATE_LIMIT_ASK_PER_MIN=20
# RATE_LIMIT_ESTATE_PER_MIN=6

# Build identifier surfaced by GET /api/health as "version". Not required for
# local dev (defaults to "dev"); set by CI/deploy tooling if you want each
# deployed image to report its commit SHA.
# BUILD_SHA=
