# Progress Agentic RAG - account level (used by `npm run provision` only)
ARAG_ZONE=aws-ap-southeast-2-1
ARAG_ACCOUNT=your-account-id
ARAG_NUA_KEY=your-account-nua-key

# Per-tenant knowledge box bindings (written automatically by `npm run provision`)
# ARAG_KB_GRDC=...
# ARAG_KB_GRDC_TOKEN=...
# ARAG_KB_FRDC=...
# ARAG_KB_FRDC_TOKEN=...
